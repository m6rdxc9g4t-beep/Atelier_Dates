# Supabase → Project Settings → API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL publique du site (utilisée dans les liens de connexion envoyés par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuseau horaire d'affichage (les serveurs Vercel sont en UTC)
NEXT_PUBLIC_APP_TIMEZONE=Europe/Paris

# Notifications push (Web Push) — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services push d'Apple/Google (URL https ou mailto:)
VAPID_SUBJECT=https://atelier-dates.vercel.app

# E-mails et SMS via Brevo (brevo.com → SMTP & API → Clés API)
BREVO_API_KEY=
# Adresse d'expéditeur vérifiée dans Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Notre Petit Monde
# Nom d'expéditeur des SMS (11 caractères max, lettres et chiffres)
BREVO_SMS_SENDER=PetitMonde
